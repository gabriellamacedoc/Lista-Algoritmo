# - Listas melhor e atual: guardam os dados do melhor intervalo e do
#   intervalo de maior soma que termina no periodo atual.

import sys


# Registra o lucro de um periodo, atualiza o melhor intervalo
# e atualiza a pilha de prosperidade.
# O historico guarda os lucros ja registrados.
# A funcao retorna a nova soma dos residuos da pilha.
#
# Complexidade: O(1) amortizado por periodo.
# Cada lucro entra uma vez no historico e na pilha, podendo ser
# removido da pilha no maximo uma vez.

def registrar_periodo(lucro, numero, historico, melhor,
                      atual, pilha, soma_pilha):

    historico.append(lucro)

    # Atualiza o melhor intervalo consecutivo.
    if numero == 1:
        melhor[0] = lucro
        melhor[1] = 1
        melhor[2] = 1

        atual[0] = lucro
        atual[1] = 1

    else:
        # Verifica se e melhor continuar o intervalo anterior
        # ou comecar um novo intervalo neste periodo.
        if atual[0] + lucro >= lucro:
            atual[0] = atual[0] + lucro
        else:
            atual[0] = lucro
            atual[1] = numero

        # Atualiza o melhor intervalo.
        # Em caso de empate, mantem o intervalo mais antigo.
        if atual[0] > melhor[0]:
            melhor[0] = atual[0]
            melhor[1] = atual[1]
            melhor[2] = numero

        elif atual[0] == melhor[0]:
            if atual[1] < melhor[1]:
                melhor[0] = atual[0]
                melhor[1] = atual[1]
                melhor[2] = numero

            elif atual[1] == melhor[1] and numero < melhor[2]:
                melhor[0] = atual[0]
                melhor[1] = atual[1]
                melhor[2] = numero

    # Atualiza a pilha de prosperidade.
    if lucro > 0:
        pilha.append([numero, lucro])
        soma_pilha += lucro

    elif lucro < 0:
        prejuizo = -lucro

        # Usa os lucros mais recentes para compensar o prejuizo.
        while prejuizo > 0 and len(pilha) > 0:
            topo = pilha[-1]
            residuo = topo[1]

            if residuo <= prejuizo:
                # O lucro do topo foi totalmente consumido.
                prejuizo -= residuo
                soma_pilha -= residuo
                pilha.pop()

            else:
                # O lucro do topo foi parcialmente consumido.
                topo[1] -= prejuizo
                soma_pilha -= prejuizo
                prejuizo = 0

    return soma_pilha


