# REDE (Entregável 1)
# ======================================================================
class Rede:
    """Estado da rede no Entregável 1: registro + histórico de períodos.
    Campos: T (tolerância), reg (Registro), melhor (MelhorIntervalo),
    prosp (PilhaProsperidade). Os métodos criar_deposito/adicionar_rota/
    cmd_lucro são pontos de extensão que os entregáveis seguintes sobrescrevem."""

    def __init__(self, T):
        self.T = T
        self.reg = Registro()
        self.melhor = MelhorIntervalo()
        self.prosp = PilhaProsperidade()

    def criar_deposito(self, ident, x, y, lucro):
        """Recebe id novo, coordenadas e lucro. Faz: insere no registro.
        Tempo: O(1) esperado."""
        self.reg.inserir(ident, x, y, lucro)

    def adicionar_rota(self, u, v, c):
        """Rota lida mas descartada neste estágio. Tempo: O(1)."""

    def cmd_inserir(self, ident, x, y, lucro, rotas):
        """INSERIR: recebe o depósito e a lista de r rotas (u, v, c).
        Faz: cria o depósito e registra as rotas. Não imprime.
        Tempo: O(r) esperado (r <= 20), mais o custo de criar_deposito."""
        self.criar_deposito(ident, x, y, lucro)
        for u, v, c in rotas:
            self.adicionar_rota(u, v, c)

    def cmd_lucro(self, ident, lucro):
        """LUCRO: troca o lucro do depósito vivo ident. Não imprime.
        Tempo: O(1) esperado (total é ajustado pela diferença)."""
        self.reg.mudar_lucro(ident, lucro)

    def cmd_melhor(self):
        """MELHOR: devolve 'i j S' sobre os períodos já registrados.
        Tempo: O(1) (resposta mantida online por Kadane)."""
        return self.melhor.consultar()

    def cmd_prosperidade(self):
        """PROSPERIDADE: devolve a linha da pilha após o último período
        registrado. Tempo: O(1)."""
        return self.prosp.consultar()

    def fechar_periodo(self, k):
        """Recebe o número k do período que acabou de terminar. Faz: lê o lucro
        Lk = reg.total (sem varrer depósitos) e o registra em MELHOR e na pilha.
        Tempo: O(1) amortizado (a pilha pode desempilhar vários elementos,
        pagos pelos empilhamentos)."""
        L = self.reg.total
        self.melhor.registrar(k, L)
        self.prosp.registrar(k, L)


