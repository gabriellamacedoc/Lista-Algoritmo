# REDE (Entregável 2): fechamento e proximidade
# ======================================================================
class RedeFechamento(Rede):
    """Acrescenta à Rede: fila de prioridade por lucro e cache do par.
    Campos novos:
      fila: FilaPrioridade com chave = lucro e um elemento por depósito vivo.
      par_cache: último resultado de PAR (d2, a, b) ou None se inválido.
    Invariantes: ids da fila == chaves de reg.dados e chave == lucro atual;
    par_cache só é não-None enquanto o conjunto de vivos não mudou."""

    def __init__(self, T):
        super().__init__(T)
        self.fila = FilaPrioridade()
        self.par_cache = None

    def criar_deposito(self, ident, x, y, lucro):
        """Cria no registro e na fila; invalida o cache de PAR.
        Tempo: O(log n) (inserção no heap)."""
        super().criar_deposito(ident, x, y, lucro)
        self.fila.inserir(ident, lucro)
        self.par_cache = None

    def cmd_lucro(self, ident, lucro):
        """LUCRO: atualiza o registro e a chave na fila (conjunto de vivos não
        muda, o cache de PAR continua válido). Tempo: O(log n)."""
        super().cmd_lucro(ident, lucro)
        self.fila.atualizar(ident, lucro)

    def eliminar(self, ident):
        """Remove o depósito ident (já retirado da fila) das estruturas que o
        mencionam. Tempo: O(1) esperado aqui; sobrescrito no Entregável 3."""
        self.reg.remover(ident)
        self.par_cache = None

    def cmd_remover(self):
        """REMOVER: fecha todo depósito com lucro < T extraindo o mínimo da
        fila enquanto sua chave for < T. Devolve a quantidade removida (str).
        Tempo: O((k+1) log n) para k removidos — nunca examina os demais."""
        cont = 0
        fila = self.fila
        while len(fila) and fila.minimo()[0] < self.T:
            _, ident = fila.extrair_min()
            self.eliminar(ident)
            cont += 1
        return str(cont)

    def cmd_par(self):
        """PAR: devolve 'a b d' (a<b ids do par mais próximo, d distância
        euclidiana arredondada para cima). Reutiliza o último resultado se os
        vivos não mudaram. Tempo: O(n log n) (divisão e conquista); O(1) com
        cache. Espaço: O(n)."""
        if self.par_cache is None:
            pts = [(d[0], d[1], i) for i, d in self.reg.dados.items()]
            self.par_cache = par_mais_proximo(pts)
        d2, a, b = self.par_cache
        return "%d %d %d" % (a, b, teto_raiz(d2))


