# FILA DE PRIORIDADE COM ALTERAÇÃO DE CHAVE (Entregável 2)
# ======================================================================
class FilaPrioridade:
    """Min-heap binário indexado (implementação própria).

    Campos:
      chaves: lista das chaves na ordem do heap.
      ids:    lista paralela dos identificadores.
      pos:    dict id -> índice do id em ids/chaves.
    Invariantes: chaves[(i-1)//2] <= chaves[i] (propriedade de heap);
    ids[pos[d]] == d para todo d presente; ids sem repetição.
    O índice pos permite alterar a chave de um id em O(log n), o que uma
    heapq (sem decrease-key) não oferece; é reutilizada pelo Dijkstra.
    """

    def __init__(self):
        self.chaves = []
        self.ids = []
        self.pos = {}

    def __len__(self):
        return len(self.ids)

    def _subir(self, i):
        chaves, ids, pos = self.chaves, self.ids, self.pos
        k, d = chaves[i], ids[i]
        while i > 0:
            p = (i - 1) >> 1
            if chaves[p] <= k:
                break
            chaves[i] = chaves[p]
            ids[i] = ids[p]
            pos[ids[i]] = i
            i = p
        chaves[i] = k
        ids[i] = d
        pos[d] = i

    def _descer(self, i):
        chaves, ids, pos = self.chaves, self.ids, self.pos
        n = len(ids)
        k, d = chaves[i], ids[i]
        while True:
            c = 2 * i + 1
            if c >= n:
                break
            if c + 1 < n and chaves[c + 1] < chaves[c]:
                c += 1
            if chaves[c] >= k:
                break
            chaves[i] = chaves[c]
            ids[i] = ids[c]
            pos[ids[i]] = i
            i = c
        chaves[i] = k
        ids[i] = d
        pos[d] = i

    def inserir(self, ident, chave):
        """Recebe id ausente e sua chave. Faz: insere no fim e sobe.
        Tempo: O(log n) no pior caso (altura do heap)."""
        self.chaves.append(chave)
        self.ids.append(ident)
        self._subir(len(self.ids) - 1)

    def atualizar(self, ident, chave):
        """Recebe id presente e nova chave. Faz: troca a chave e restaura o
        heap subindo (se diminuiu) ou descendo (se aumentou).
        Tempo: O(log n) no pior caso."""
        i = self.pos[ident]
        antiga = self.chaves[i]
        self.chaves[i] = chave
        if chave < antiga:
            self._subir(i)
        elif chave > antiga:
            self._descer(i)

    def minimo(self):
        """Pré-condição: fila não vazia. Devolve (chave, id) mínimos sem
        removê-los. Tempo: O(1)."""
        return self.chaves[0], self.ids[0]

    def extrair_min(self):
        """Pré-condição: fila não vazia. Remove e devolve (chave, id) mínimos:
        move o último elemento à raiz e desce. Tempo: O(log n)."""
        k0, d0 = self.chaves[0], self.ids[0]
        ck = self.chaves.pop()
        cd = self.ids.pop()
        del self.pos[d0]
        if self.ids:
            self.chaves[0] = ck
            self.ids[0] = cd
            self.pos[cd] = 0
            self._descer(0)
        return k0, d0


