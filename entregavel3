# PAR MAIS PRÓXIMO (Entregável 2) — divisão e conquista
# ======================================================================
def par_mais_proximo(pontos):
    """Recebe: lista de tuplas (x, y, id) com >= 2 pontos de coordenadas
    distintas. Devolve (d2, a, b): menor distância ao quadrado (inteira,
    exata) e os ids a < b do par. Nenhuma distância entre pares é armazenada
    além do melhor corrente.
    Algoritmo: ordena por x; divide ao meio; resolve cada metade (que devolve
    seus pontos ordenados por y, como no merge sort); na faixa vertical de
    largura sqrt(melhor) em torno da divisória compara cada ponto apenas com
    os seguintes na ordem de y cuja diferença de y ainda é < sqrt(melhor)
    (no máximo O(1) pontos, argumento de empacotamento).
    Tempo: O(n log n) no pior caso (T(n)=2T(n/2)+O(n)).
    Espaço adicional: O(n) (listas ordenadas por nível, profundidade O(log n))."""
    P = sorted(pontos)
    melhor = [1 << 100, 0, 0]

    def rec(lo, hi):
        if hi - lo <= 3:
            for i in range(lo, hi):
                xi, yi, di = P[i]
                for j in range(i + 1, hi):
                    dx = P[j][0] - xi
                    dy = P[j][1] - yi
                    d = dx * dx + dy * dy
                    if d < melhor[0]:
                        melhor[0], melhor[1], melhor[2] = d, di, P[j][2]
            return sorted(P[lo:hi], key=lambda p: p[1])
        mid = (lo + hi) >> 1
        xm = P[mid][0]
        esq = rec(lo, mid)
        dir_ = rec(mid, hi)
        ordenado = sorted(esq + dir_, key=lambda p: p[1])  # duas runs: O(n)
        faixa = [p for p in ordenado if (p[0] - xm) ** 2 < melhor[0]]
        nf = len(faixa)
        for i in range(nf):
            xi, yi, di = faixa[i]
            for j in range(i + 1, nf):
                xj, yj, dj = faixa[j]
                dy = yj - yi
                if dy * dy >= melhor[0]:
                    break
                dx = xj - xi
                d = dx * dx + dy * dy
                if d < melhor[0]:
                    melhor[0], melhor[1], melhor[2] = d, di, dj
        return ordenado

    rec(0, len(P))
    a, b = melhor[1], melhor[2]
    if a > b:
        a, b = b, a
    return melhor[0], a, b


def teto_raiz(d2):
    """Recebe d2 >= 0 inteiro. Devolve o menor inteiro t com t*t >= d2, com
    aritmética inteira (math.isqrt). Tempo: O(1) para d2 de 64 bits."""
    r = isqrt(d2)
    return r if r * r == d2 else r + 1


