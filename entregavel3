# GRAFO DE ROTAS (Entregável 3)
# ======================================================================
class Grafo:
    """Grafo dirigido dinâmico em listas de adjacência esparsas.

    Campos:
      saida:   dict u -> dict {v: custo} das rotas que saem de u.
      entrada: dict v -> set {u} dos u com rota u->v (índice reverso, para
               remover um nó sem varrer o grafo todo).
    Invariantes: v in saida[u]  <=>  u in entrada[v]; toda chave é um depósito
    vivo; não há laços nem rotas duplicadas. Espaço: O(n + m).
    dict/set da biblioteca: inserir/buscar/remover O(1) esperado (hash).
    """

    def __init__(self):
        self.saida = {}
        self.entrada = {}

    def adicionar_no(self, ident):
        """Cria nó isolado. Tempo: O(1) esperado."""
        self.saida[ident] = {}
        self.entrada[ident] = set()

    def adicionar_rota(self, u, v, c):
        """Recebe nós vivos u, v e custo c >= 1. Faz: cria a rota u->v (se já
        existir, substitui o custo). Tempo: O(1) esperado."""
        self.saida[u][v] = c
        self.entrada[v].add(u)

    def remover_no(self, ident):
        """Recebe nó vivo. Faz: remove o nó e todas as rotas que entram ou
        saem dele, nos dois índices. Tempo: O(grau de entrada + grau de saída)
        esperado."""
        for w in self.saida.pop(ident):
            self.entrada[w].discard(ident)
        for u in self.entrada.pop(ident):
            del self.saida[u][ident]


def dijkstra(grafo, s):
    """Recebe o grafo (custos >= 1) e o nó de origem s. Devolve dict
    nó -> menor custo para os nós alcançáveis (inclui s com 0).
    Usa a FilaPrioridade do Entregável 2 com decrease-key: cada nó entra na
    fila no máximo uma vez. Tempo: O((n + m) log n). Espaço: O(n)."""
    dist = {s: 0}
    fila = FilaPrioridade()
    fila.inserir(s, 0)
    saida = grafo.saida
    while len(fila):
        d, u = fila.extrair_min()
        for v, c in saida[u].items():
            nd = d + c
            od = dist.get(v)
            if od is None:
                dist[v] = nd
                fila.inserir(v, nd)
            elif nd < od:
                dist[v] = nd
                fila.atualizar(v, nd)
    return dist


# ======================================================================
# REDE (Entregável 3): rede de rotas
# ======================================================================
class RedeRotas(RedeFechamento):
    """Acrescenta à RedeFechamento o grafo de rotas (campo grafo: Grafo).
    Invariante: nós do grafo == depósitos vivos do registro."""

    def __init__(self, T):
        super().__init__(T)
        self.grafo = Grafo()

    def criar_deposito(self, ident, x, y, lucro):
        """Cria o depósito nas estruturas anteriores e o nó no grafo.
        Tempo: O(log n)."""
        super().criar_deposito(ident, x, y, lucro)
        self.grafo.adicionar_no(ident)

    def adicionar_rota(self, u, v, c):
        """Insere a rota u->v no grafo. Tempo: O(1) esperado."""
        self.grafo.adicionar_rota(u, v, c)

    def eliminar(self, ident):
        """Remove o depósito do registro e o nó (com suas rotas) do grafo.
        Tempo: O(grau) esperado."""
        super().eliminar(ident)
        self.grafo.remover_no(ident)

    def cmd_dist(self, s):
        """DIST: devolve a linha com o menor custo de s a cada outro vivo, em
        ordem crescente de id, -1 se inalcançável (linha vazia se s é o único).
        Tempo: O((n + m) log n) (Dijkstra) + O(n log n) para ordenar os ids.
        Espaço: O(n)."""
        dist = dijkstra(self.grafo, s)
        return " ".join(str(dist.get(i, -1)) for i in sorted(self.reg.dados)
                        if i != s)

RedeFinal = RedeRotas


