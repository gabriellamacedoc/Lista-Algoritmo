# PONTO DE ANCORAGEM
# ======================================================================
def main():
    """Lê toda a entrada padrão, executa setup e lotes e escreve as respostas.
    Pré-condição: entrada no formato do enunciado. Efeito: imprime uma linha por
    DIST/PAR/REMOVER/MELHOR/PROSPERIDADE. Rotas são sempre lidas.
    Tempo: soma das operações tratadas (ver métodos de Rede*); a leitura e o
    despacho são O(tamanho da entrada). Espaço: O(entrada) para os tokens."""
    tk = sys.stdin.buffer.read().split()
    n, m, T = int(tk[0]), int(tk[1]), int(tk[2])
    pos = 3
    rede = RedeFinal(T)
    for _ in range(n):
        rede.criar_deposito(int(tk[pos]), int(tk[pos + 1]),
                            int(tk[pos + 2]), int(tk[pos + 3]))
        pos += 4
    for _ in range(m):
        rede.adicionar_rota(int(tk[pos]), int(tk[pos + 1]), int(tk[pos + 2]))
        pos += 3
    P = int(tk[pos])
    pos += 1
    rede.fechar_periodo(1)
    saida = []
    for k in range(2, P + 2):
        q = int(tk[pos])
        pos += 1
        for _ in range(q):
            op = tk[pos]
            pos += 1
            if op == b"LUCRO":
                rede.cmd_lucro(int(tk[pos]), int(tk[pos + 1]))
                pos += 2
            elif op == b"INSERIR":
                ident, x, y, L, r = (int(t) for t in tk[pos:pos + 5])
                pos += 5
                rotas = [(int(tk[pos + 3 * i]), int(tk[pos + 3 * i + 1]),
                          int(tk[pos + 3 * i + 2])) for i in range(r)]
                pos += 3 * r
                rede.cmd_inserir(ident, x, y, L, rotas)
            elif op == b"MELHOR":
                saida.append(rede.cmd_melhor())
            elif op == b"PROSPERIDADE":
                saida.append(rede.cmd_prosperidade())
            elif op == b"REMOVER":
                saida.append(rede.cmd_remover())
            elif op == b"PAR":
                saida.append(rede.cmd_par())
            elif op == b"DIST":
                saida.append(rede.cmd_dist(int(tk[pos])))
                pos += 1
        rede.fechar_periodo(k)
    sys.stdout.write("\n".join(saida) + ("\n" if saida else ""))


if __name__ == "__main__":
    main()
