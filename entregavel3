"""
Nome: <SEU NOME AQUI>
Algoritmos e Estruturas de Dados — Rede de distribuição — Entregável 3: rede de rotas

Estruturas de dados e por que foram escolhidas:
- dict id -> [x, y, lucro] (Registro): acesso por id em O(1) esperado (ids até 1e9, <= 5000 vivos) e lucro total mantido incrementalmente, sem varrer depósitos.
- Kadane online (MelhorIntervalo): MELHOR em O(1) sem reexaminar o histórico.
- Pilha de prosperidade (list): empilha/desempilha em O(1) amortizado.
- Min-heap indexado próprio (FilaPrioridade): REMOVER acha os de lucro < T em O(log n) cada e LUCRO altera chave em O(log n).
- Divisão e conquista (par_mais_proximo): PAR em O(n log n), sem estrutura de distâncias entre pares; só guarda o último resultado enquanto os vivos não mudam.
- Grafo dirigido esparso (dict de dict + índice reverso de entrada): INSERIR/remoção de nó em O(grau); Dijkstra reutiliza a FilaPrioridade (decrease-key).
"""
import sys
from math import isqrt


# ======================================================================
# REGISTRO DE DEPÓSITOS (Entregável 1; ganha remoção no Entregável 2)
# ======================================================================
class Registro:
    """Registro dos depósitos vivos, com acesso por identificador.

    Estrutura da biblioteca: dict (tabela hash). get/set/del em O(1) esperado
    (hipótese: hash uniforme). Escolhida porque os ids chegam a 10^9 (vetor
    direto é inviável) e há no máximo 5000 vivos.

    Campos:
      dados: dict id -> [x, y, lucro]; as chaves são exatamente os depósitos vivos.
      total: soma dos lucros de todos os depósitos vivos (inclusive os abaixo
             da tolerância ainda não removidos).
    Invariante: total == sum(d[2] for d in dados.values()), mantido de forma
    incremental (nunca se varre o registro para obter o lucro do período).
    """

    def __init__(self):
        self.dados = {}
        self.total = 0

    def inserir(self, ident, x, y, lucro):
        """Recebe: id ainda não vivo, coordenadas e lucro inicial.
        Faz: cria o depósito e soma seu lucro em total. Devolve nada.
        Tempo: O(1) esperado (inserção em hash). Espaço extra: O(1)."""
        self.dados[ident] = [x, y, lucro]
        self.total += lucro

    def mudar_lucro(self, ident, lucro):
        """Recebe: id de depósito vivo e novo lucro (substitui o anterior).
        Faz: atualiza o lucro e ajusta total pela diferença. Devolve nada.
        Tempo: O(1) esperado (busca em hash)."""
        d = self.dados[ident]
        self.total += lucro - d[2]
        d[2] = lucro

    def remover(self, ident):
        """Recebe: id de depósito vivo.
        Faz: elimina o depósito do registro e subtrai seu lucro de total.
        Tempo: O(1) esperado (remoção em hash)."""
        d = self.dados.pop(ident)
        self.total -= d[2]


