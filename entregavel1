# HISTÓRICO: MELHOR INTERVALO E PILHA DE PROSPERIDADE
# ======================================================================
class MelhorIntervalo:
    """Soma máxima de subvetor consecutivo, mantida online (Kadane).

    Campos:
      fim_soma, fim_ini: maior soma de um intervalo que termina no último
                         período registrado e o menor início que a atinge.
      melhor: tupla (i, j, S) do melhor intervalo global, ou None se vazio.
    Invariantes: após registrar o período k, fim_* descreve o melhor intervalo
    terminando em k (menor i nos empates) e melhor é o ótimo sobre [1..k]
    com desempate por menor i e depois menor j.
    Não guarda o histórico: o espaço é O(1).
    """

    def __init__(self):
        self.fim_soma = 0
        self.fim_ini = 0
        self.melhor = None

    def registrar(self, k, lucro):
        """Recebe: k (próximo período, consecutivo) e seu lucro Lk.
        Faz: estende o intervalo anterior se sua soma for >= 0 (em empate
        prefere-se o menor início), senão recomeça em k; atualiza o melhor
        global só se a soma for maior, ou igual com início menor (assim o
        menor j é preservado). Tempo: O(1). Espaço: O(1)."""
        if k > 1 and self.fim_soma >= 0:
            self.fim_soma += lucro
        else:
            self.fim_soma = lucro
            self.fim_ini = k
        b = self.melhor
        if b is None or self.fim_soma > b[2] or (
                self.fim_soma == b[2] and self.fim_ini < b[0]):
            self.melhor = (self.fim_ini, k, self.fim_soma)

    def consultar(self):
        """Devolve a linha 'i j S' do melhor intervalo dos períodos já
        registrados (pré-condição: ao menos um período). Tempo: O(1)."""
        i, j, s = self.melhor
        return "%d %d %d" % (i, j, s)


class PilhaProsperidade:
    """Pilha de prosperidade (base = ganho mais antigo, topo = mais recente).

    Estrutura: list do Python usada como pilha (append/pop em O(1) amortizado).
    Campos:
      pilha: lista de pares [j, r] com r > 0 (resíduo estritamente positivo).
      soma:  soma dos resíduos da pilha.
    Invariantes: todo r > 0; os j são estritamente crescentes da base ao topo;
    soma == sum(r); se não vazia e b é o período da base, soma = Lb+...+Lk.
    """

    def __init__(self):
        self.pilha = []
        self.soma = 0

    def registrar(self, k, lucro):
        """Recebe: período k e seu lucro Lk. Faz: Lk>0 empilha [k,Lk]; Lk=0
        nada; Lk<0 compensa d=-Lk consumindo topos (reduz o topo ou o
        desempilha), descartando a sobra se esvaziar.
        Tempo: O(1) amortizado — cada elemento é empilhado uma vez e
        desempilhado no máximo uma vez (pior caso de uma chamada: O(h))."""
        if lucro > 0:
            self.pilha.append([k, lucro])
            self.soma += lucro
        elif lucro < 0:
            d = -lucro
            pilha = self.pilha
            while d > 0 and pilha:
                topo = pilha[-1]
                if topo[1] > d:
                    topo[1] -= d
                    self.soma -= d
                    d = 0
                else:
                    pilha.pop()
                    self.soma -= topo[1]
                    d -= topo[1]

    def consultar(self):
        """Devolve '0' se vazia, senão 'h b s i r' (altura, período da base,
        soma dos resíduos, período e resíduo do topo). Tempo: O(1)."""
        if not self.pilha:
            return "0"
        i, r = self.pilha[-1]
        return "%d %d %d %d %d" % (len(self.pilha), self.pilha[0][0],
                                   self.soma, i, r)


