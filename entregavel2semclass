import sys
import heapq
from math import isqrt


# Encontra o par de depositos geograficamente mais proximo.
# Recebe os depositos vivos no formato (x, y, identificador).
# Devolve os dois identificadores e o quadrado da distancia.
#
# Complexidade: O(n log n), usando divisao e conquista.
# Espaco adicional: O(n).

def par_mais_proximo(depositos):
    pontos_x = sorted(depositos)

    # Ordena os pontos pela coordenada y.
    pontos_y = sorted(depositos, key=lambda p: (p[1], p[0]))

    def encontrar(pontos_x, pontos_y):
        quantidade = len(pontos_x)

        # Para poucos pontos, compara todos os pares.
        if quantidade <= 3:
            melhor_distancia = float("inf")
            melhor_par = None

            for i in range(quantidade):
                for j in range(i + 1, quantidade):
                    x1, y1, id1 = pontos_x[i]
                    x2, y2, id2 = pontos_x[j]

                    distancia = (x1 - x2) ** 2 + (y1 - y2) ** 2

                    if distancia < melhor_distancia:
                        melhor_distancia = distancia
                        melhor_par = (id1, id2)

            return melhor_distancia, melhor_par

        # Divide os pontos em duas metades.
        meio = quantidade // 2
        metade_esquerda = pontos_x[:meio]
        metade_direita = pontos_x[meio:]

        x_meio = pontos_x[meio][0]

        # Separa os pontos ordenados por y nas mesmas metades.
        conjunto_esquerda = set(metade_esquerda)

        y_esquerda = []
        y_direita = []

        for ponto in pontos_y:
            if ponto in conjunto_esquerda:
                y_esquerda.append(ponto)
            else:
                y_direita.append(ponto)

        # Encontra o melhor par de cada metade.
        dist_esquerda, par_esquerda = encontrar(
            metade_esquerda, y_esquerda
        )

        dist_direita, par_direita = encontrar(
            metade_direita, y_direita
        )

        if dist_esquerda <= dist_direita:
            melhor_distancia = dist_esquerda
            melhor_par = par_esquerda
        else:
            melhor_distancia = dist_direita
            melhor_par = par_direita

        # Seleciona os pontos proximos da linha divisoria.
        faixa = []

        for ponto in pontos_y:
            if (ponto[0] - x_meio) ** 2 < melhor_distancia:
                faixa.append(ponto)

        # Compara os pontos da faixa pela coordenada y.
        for i in range(len(faixa)):
            j = i + 1

            while j < len(faixa):
                diferenca_y = faixa[j][1] - faixa[i][1]

                if diferenca_y ** 2 >= melhor_distancia:
                    break

                x1, y1, id1 = faixa[i]
                x2, y2, id2 = faixa[j]

                distancia = (x1 - x2) ** 2 + (y1 - y2) ** 2

                if distancia < melhor_distancia:
                    melhor_distancia = distancia
                    melhor_par = (id1, id2)

                j += 1

        return melhor_distancia, melhor_par

    distancia, par = encontrar(pontos_x, pontos_y)

    return par[0], par[1], distancia


def main():
    # Le toda a entrada.
    dados = sys.stdin.read().split()
    pos = 0

    # Le o cabecalho.
    n = int(dados[pos])
    m = int(dados[pos + 1])
    T = int(dados[pos + 2])
    pos += 3

    # Cada deposito guarda suas coordenadas e seu lucro.
    # Formato: identificador -> [x, y, lucro]
    depositos = {}

    # Fila de prioridade: (lucro, identificador).
    fila = []

    # Le os depositos iniciais.
    for _ in range(n):
        ident = int(dados[pos])
        x = int(dados[pos + 1])
        y = int(dados[pos + 2])
        lucro = int(dados[pos + 3])
        pos += 4

        depositos[ident] = [x, y, lucro]
        heapq.heappush(fila, (lucro, ident))

    # Le as rotas iniciais, que nao serao usadas no E2.
    for _ in range(m):
        u = int(dados[pos])
        v = int(dados[pos + 1])
        c = int(dados[pos + 2])
        pos += 3

    # Le a quantidade de periodos depois do primeiro.
    P = int(dados[pos])
    pos += 1

    # Processa os lotes dos periodos 2 ate P + 1.
    for periodo in range(2, P + 2):
        q = int(dados[pos])
        pos += 1

        for _ in range(q):
            operacao = dados[pos]
            pos += 1

            if operacao == "INSERIR":
                ident = int(dados[pos])
                x = int(dados[pos + 1])
                y = int(dados[pos + 2])
                lucro = int(dados[pos + 3])
                r = int(dados[pos + 4])
                pos += 5

                depositos[ident] = [x, y, lucro]

                # Adiciona o novo deposito a fila.
                heapq.heappush(fila, (lucro, ident))

                # Le as rotas do novo deposito.
                for _ in range(r):
                    u = int(dados[pos])
                    v = int(dados[pos + 1])
                    c = int(dados[pos + 2])
                    pos += 3

            elif operacao == "LUCRO":
                ident = int(dados[pos])
                novo_lucro = int(dados[pos + 1])
                pos += 2

                # Substitui o lucro do deposito.
                depositos[ident][2] = novo_lucro

                # Insere o novo valor na fila.
                # O valor antigo sera ignorado quando aparecer no topo.
                heapq.heappush(fila, (novo_lucro, ident))

            elif operacao == "REMOVER":
                quantidade_removida = 0

                # Enquanto houver lucro abaixo da tolerancia,
                # remove o deposito correspondente.
                while fila:
                    lucro, ident = fila[0]

                    # Ignora depositos que ja foram removidos.
                    if ident not in depositos:
                        heapq.heappop(fila)
                        continue

                    # Ignora valores antigos apos uma alteracao de lucro.
                    if depositos[ident][2] != lucro:
                        heapq.heappop(fila)
                        continue

                    # O menor lucro atual nao esta abaixo de T.
                    if lucro >= T:
                        break

                    # Remove o deposito da rede.
                    heapq.heappop(fila)
                    del depositos[ident]
                    quantidade_removida += 1

                print(quantidade_removida)

            elif operacao == "PAR":
                # Prepara os depositos vivos para a busca.
                pontos = []

                for ident in depositos:
                    x = depositos[ident][0]
                    y = depositos[ident][1]
                    pontos.append((x, y, ident))

                id1, id2, distancia_quadrada = par_mais_proximo(
                    pontos
                )

                # Arredonda a distancia para cima usando inteiros.
                distancia = isqrt(distancia_quadrada)

                if distancia * distancia < distancia_quadrada:
                    distancia += 1

                # Os identificadores devem aparecer em ordem crescente.
                if id1 > id2:
                    id1, id2 = id2, id1

                print(id1, id2, distancia)


if __name__ == "__main__":
